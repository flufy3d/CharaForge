node_modules/
dist/
*.tsbuildinfo
.DS_Store

# Live2D Cubism SDK（Core/Framework）不进仓库，由 pnpm setup:cubism 安装
vendor/

# 模型、视频、音频等外部资源不进仓库，由 pnpm setup:assets 下载
assets/
.cache/

# 编辑器覆盖保存时自动生成的备份（人工确认后可删）
scenes/**/*.bak.json
packages/scene/examples/*.bak.json

# 中间产物：抽帧、拟合结果、质检报告等
.data/
out/

# Python
.venv/
__pycache__/
*.pyc
