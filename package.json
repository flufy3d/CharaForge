{
  "name": "charaforge",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:cubism": "node scripts/setup-cubism.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "setup:py": "uv sync --project tools",
    "setup": "pnpm setup:cubism && pnpm setup:assets && pnpm setup:py",
    "schema": "pnpm --filter @charaforge/scene run schema",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "framework": "node packages/runtime/scripts/build-framework.mjs",
    "dev": "pnpm --filter @charaforge/player dev",
    "preview": "pnpm --filter @charaforge/player preview",
    "render": "node packages/runtime/scripts/build-framework.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/render.ts",
    "render:gallery": "node packages/runtime/scripts/build-framework.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/gallery.ts",
    "accessory:import": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/import-accessory.mjs",
    "decoration:command": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/decoration-command.mjs",
    "editor:command": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/editor-command.ts",
    "export:video": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/export-video.ts",
    "test:runtime": "pnpm --filter @charaforge/runtime test",
    "test:viewer": "pnpm --filter @charaforge/player test:viewer",
    "test:editor": "pnpm --filter @charaforge/player test:editor",
    "test:editor-api": "pnpm --filter @charaforge/player test:editor-api",
    "verify:video": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/verify-video.ts",
    "bench": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/player/scripts/bench.ts"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "^5.9.3"
  }
}
